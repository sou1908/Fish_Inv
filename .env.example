# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "URI".
# Use the Transaction pooler URI (host has "pooler.supabase.com", port 6543) for
# serverless/Vercel. The password is your database password (not the anon key).
DATABASE_URL="postgresql://postgres.xxxx:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"

# Single shared password to open the app.
APP_PASSWORD="change-me"

# Random long string used to sign the auth cookie. e.g. `openssl rand -hex 32`.
AUTH_SECRET="replace-with-a-long-random-string"
